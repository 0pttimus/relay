# Public URL — drives canonical tags, sitemap and social metadata
NEXT_PUBLIC_SITE_URL=https://relay.example

# --- Enquiry delivery: set up at least one of these before going live ---
# A) email through Resend
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# B) POST the enquiry JSON to an HTTPS endpoint (Slack, Zapier, Make, n8n, CRM, whatever)
ENQUIRY_WEBHOOK_URL=

# C) append to .data/enquiries.jsonl on the server
# Dev does this automatically; only turn it on in prod if we're self-hosting on Node with a persistent disk
ENQUIRY_FILE_STORE=
